// Gampangin FNB — schema.prisma
// Konvensi: id cuid(), createdAt/updatedAt di setiap model, uang & qty pakai Decimal
// (JANGAN Float), status pakai enum, index untuk kolom yang sering difilter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUM
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  FINANCE
  SALES
  PRODUKSI
}

enum MetodeBayarPOS {
  CASH
  TRANSFER_QRIS
  KREDIT
}

enum StatusBayar {
  LUNAS
  PARSIAL
  BELUM_BAYAR
}

enum StatusOrderB2B {
  DRAFT
  INVOICE
  DIKIRIM
  PARSIAL
  LUNAS
  SELESAI
  BATAL
}

enum SumberUtang {
  PEMBELIAN
  PINJAMAN
  INVESTOR
}

enum TipeModal {
  MODAL_AWAL
  PENAMBAHAN
  PRIVE
}

enum SumberDanaModal {
  UANG_SENDIRI
  PINJAMAN
  INVESTOR
}

enum TipePergerakanStok {
  IN
  OUT
}

enum SumberPergerakanStok {
  PEMBELIAN
  PRODUKSI_MASUK
  PRODUKSI_PAKAI
  PENJUALAN_POS
  PENJUALAN_B2B
  ADJUSTMENT
  WASTE
}

enum TipePembayaran {
  PIUTANG
  UTANG
}

// ---------------------------------------------------------------------------
// USER & OUTLET
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  nama         String
  username     String    @unique
  passwordHash String
  role         Role      @default(SALES)
  outletId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  outlet Outlet? @relation(fields: [outletId], references: [id])

  auditLogs      AuditLog[]
  orderPOS       OrderPOS[]
  orderB2B       OrderB2B[]
  prosesList     Proses[]
  outputList     Output[]
  pembelian      Pembelian[]
  pembayaran     Pembayaran[]
  modal          Modal[]
  pengeluaran    Pengeluaran[]

  @@index([outletId])
  @@map("users")
}

model Outlet {
  id        String   @id @default(cuid())
  nama      String
  alamat    String?
  noHP      String?  // nomor WhatsApp outlet
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  orderPOS      OrderPOS[]
  orderB2B      OrderB2B[]
  prosesList    Proses[]
  outputList    Output[]
  pembelian     Pembelian[]
  pengeluaran   Pengeluaran[]

  @@map("outlets")
}

model Pengaturan {
  id        String   @id @default("singleton")
  namaToko  String   @default("Gampangin FNB")
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("pengaturan")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  aksi      String // CREATE / UPDATE / DELETE / LOGIN / EXPORT / RESET_DATA
  entitas   String
  entitasId String?
  detail    Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entitas, entitasId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// MASTER DATA — DATABASE
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  nama      String
  kontak    String?
  alamat    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderPOS OrderPOS[]

  @@index([nama])
  @@map("customers")
}

model Agen {
  id        String   @id @default(cuid())
  nama      String
  kontak    String?
  noHP      String?  // nomor WhatsApp
  alamat    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderB2B OrderB2B[]

  @@index([nama])
  @@map("agen")
}

model Supplier {
  id        String   @id @default(cuid())
  nama      String
  kontak    String?
  alamat    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pembelian Pembelian[]

  @@index([nama])
  @@map("suppliers")
}

model BahanBaku {
  id           String   @id @default(cuid())
  nama         String
  satuan       String // kg, gr, L, ml, pcs, dst — dari dropdown SATUAN_OPTIONS
  stok         Decimal  @default(0) @db.Decimal(15, 3)
  stokMinimum  Decimal  @default(0) @db.Decimal(15, 3)
  // Harga satuan per 1 satuan stok. Diisi manual untuk stok awal;
  // setelah ada pembelian, di-update otomatis jadi rata-rata tertimbang.
  hargaRataRata Decimal @default(0) @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pembelianItem     PembelianItem[]
  prosesBahanBaku ProsesBahanBaku[]
  stokMovement      StokMovementBahanBaku[]

  @@index([nama])
  @@map("bahan_baku")
}

model Kemasan {
  id          String   @id @default(cuid())
  nama        String
  satuan      String // pcs, botol, dus, dst
  stok        Decimal  @default(0) @db.Decimal(15, 3)
  stokMinimum Decimal  @default(0) @db.Decimal(15, 3)
  harga       Decimal  @default(0) @db.Decimal(15, 2) // harga per unit kemasan (untuk HPP)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pembelianItem  PembelianItem[]
  outputKemasan OutputKemasan[]
  stokMovement   StokMovementKemasan[]
  produkJadi     ProdukJadi[]

  @@index([nama])
  @@map("kemasan")
}

model ProdukJadi {
  id                 String   @id @default(cuid())
  nama               String
  satuan             String   @default("pcs")
  beratBersih        Int? // gram — dipakai untuk alokasi HPP produksi multi-output
  harga              Decimal  @default(0) @db.Decimal(15, 2)
  stok               Decimal  @default(0) @db.Decimal(15, 3)
  stokMinimum        Decimal  @default(0) @db.Decimal(15, 3)
  kemasanId          String?  // link ke kemasan default
  qtyKemasanPerUnit  Decimal  @default(1) @db.Decimal(10, 2) // berapa kemasan per 1 unit produk
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  kemasan          Kemasan?            @relation(fields: [kemasanId], references: [id])
  orderPOSItem     OrderPOSItem[]
  orderB2BItem     OrderB2BItem[]
  outputProdukJadi OutputProdukJadi[]
  stokMovement     StokMovementProdukJadi[]

  @@index([nama])
  @@index([kemasanId])
  @@map("produk_jadi")
}

// ---------------------------------------------------------------------------
// PENJUALAN POS (RETAIL)
// ---------------------------------------------------------------------------

model OrderPOS {
  id                String          @id @default(cuid())
  nomor             String          @unique
  customerId        String
  outletId          String
  userId            String
  metodeBayar       MetodeBayarPOS  @default(CASH)
  statusBayar       StatusBayar     @default(LUNAS)
  tanggalJatuhTempo DateTime?
  subtotal          Decimal         @db.Decimal(15, 2)
  total             Decimal         @db.Decimal(15, 2)
  catatan           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  outlet   Outlet   @relation(fields: [outletId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  items    OrderPOSItem[]
  piutang  Piutang?

  @@index([customerId])
  @@index([outletId])
  @@index([createdAt])
  @@index([statusBayar])
  @@map("order_pos")
}

model OrderPOSItem {
  id               String  @id @default(cuid())
  orderPOSId       String
  produkJadiId     String
  qty              Decimal @db.Decimal(15, 3)
  hargaSatuan      Decimal @db.Decimal(15, 2)
  subtotal         Decimal @db.Decimal(15, 2)
  hppSatuanSaatItu Decimal? @db.Decimal(15, 2)

  orderPOS   OrderPOS   @relation(fields: [orderPOSId], references: [id], onDelete: Cascade)
  produkJadi ProdukJadi @relation(fields: [produkJadiId], references: [id])

  @@index([orderPOSId])
  @@map("order_pos_items")
}

// ---------------------------------------------------------------------------
// PENJUALAN B2B (BUSINESS)
// ---------------------------------------------------------------------------

model OrderB2B {
  id            String          @id @default(cuid())
  nomor         String          @unique
  agenId        String
  outletId      String
  userId        String
  status        StatusOrderB2B  @default(DRAFT)
  metodeBayar   MetodeBayarPOS  @default(TRANSFER_QRIS)
  statusBayar   StatusBayar     @default(BELUM_BAYAR)
  tanggalJatuhTempo DateTime?
  subtotal      Decimal         @db.Decimal(15, 2)
  total         Decimal         @db.Decimal(15, 2)
  catatan       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  agen      Agen             @relation(fields: [agenId], references: [id])
  outlet    Outlet           @relation(fields: [outletId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  items     OrderB2BItem[]
  invoice   Invoice?
  suratJalan SuratJalan?
  piutang   Piutang?

  @@index([agenId])
  @@index([outletId])
  @@index([createdAt])
  @@index([status])
  @@map("order_b2b")
}

model OrderB2BItem {
  id               String  @id @default(cuid())
  orderB2BId       String
  produkJadiId     String
  qty              Decimal @db.Decimal(15, 3)
  hargaSatuan      Decimal @db.Decimal(15, 2)
  subtotal         Decimal @db.Decimal(15, 2)
  hppSatuanSaatItu Decimal? @db.Decimal(15, 2)

  orderB2B   OrderB2B   @relation(fields: [orderB2BId], references: [id], onDelete: Cascade)
  produkJadi ProdukJadi @relation(fields: [produkJadiId], references: [id])

  @@index([orderB2BId])
  @@map("order_b2b_items")
}

model Invoice {
  id            String   @id @default(cuid())
  orderB2BId    String   @unique
  nomorInvoice  String   @unique
  tanggalTerbit DateTime @default(now())
  createdAt     DateTime @default(now())

  orderB2B OrderB2B @relation(fields: [orderB2BId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model SuratJalan {
  id           String   @id @default(cuid())
  orderB2BId   String   @unique
  noResi       String
  tanggalKirim DateTime @default(now())
  createdAt    DateTime @default(now())

  orderB2B OrderB2B @relation(fields: [orderB2BId], references: [id], onDelete: Cascade)

  @@map("surat_jalan")
}

// ---------------------------------------------------------------------------
// UTANG & PIUTANG
// ---------------------------------------------------------------------------

model Piutang {
  id             String      @id @default(cuid())
  orderPOSId     String?     @unique
  orderB2BId     String?     @unique
  pihakNama      String // denormalized: nama Customer/Agen saat piutang dibuat
  totalTagihan   Decimal     @db.Decimal(15, 2)
  totalTerbayar  Decimal     @default(0) @db.Decimal(15, 2)
  jatuhTempo     DateTime
  status         StatusBayar @default(BELUM_BAYAR)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orderPOS   OrderPOS?    @relation(fields: [orderPOSId], references: [id])
  orderB2B   OrderB2B?    @relation(fields: [orderB2BId], references: [id])
  pembayaran Pembayaran[]

  @@index([status])
  @@index([jatuhTempo])
  @@map("piutang")
}

model Pembelian {
  id         String   @id @default(cuid())
  nomor      String   @unique
  supplierId String
  outletId   String?
  userId     String
  tanggal    DateTime @default(now())
  keterangan String?
  total      Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  outlet   Outlet?          @relation(fields: [outletId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  items    PembelianItem[]
  utang    Utang?

  @@index([supplierId])
  @@index([createdAt])
  @@map("pembelian")
}

model PembelianItem {
  id          String   @id @default(cuid())
  pembelianId String
  bahanBakuId String?
  kemasanId   String?
  qty         Decimal  @db.Decimal(15, 3)
  hargaSatuan Decimal  @db.Decimal(15, 2)
  subtotal    Decimal  @db.Decimal(15, 2)

  pembelian Pembelian  @relation(fields: [pembelianId], references: [id], onDelete: Cascade)
  bahanBaku BahanBaku? @relation(fields: [bahanBakuId], references: [id])
  kemasan   Kemasan?   @relation(fields: [kemasanId], references: [id])

  @@index([pembelianId])
  @@map("pembelian_items")
}

model Utang {
  id            String      @id @default(cuid())
  sumber        SumberUtang
  pembelianId   String?     @unique
  pihakNama     String // nama Supplier / pemberi pinjaman / investor
  keterangan    String?
  totalUtang    Decimal     @db.Decimal(15, 2)
  totalTerbayar Decimal     @default(0) @db.Decimal(15, 2)
  jatuhTempo    DateTime
  status        StatusBayar @default(BELUM_BAYAR)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  pembelian  Pembelian?   @relation(fields: [pembelianId], references: [id])
  pembayaran Pembayaran[]

  @@index([status])
  @@index([jatuhTempo])
  @@map("utang")
}

model Pembayaran {
  id         String         @id @default(cuid())
  tipe       TipePembayaran
  piutangId  String?
  utangId    String?
  jumlah     Decimal        @db.Decimal(15, 2)
  tanggal    DateTime       @default(now())
  catatan    String?
  userId     String
  createdAt  DateTime       @default(now())

  piutang Piutang? @relation(fields: [piutangId], references: [id])
  utang   Utang?   @relation(fields: [utangId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([piutangId])
  @@index([utangId])
  @@map("pembayaran")
}

// ---------------------------------------------------------------------------
// PROSES PRODUKSI — 2 langkah: Proses (input bahan baku) → Output (produk jadi + kemasan)
// ---------------------------------------------------------------------------

enum StatusProses {
  DRAFT      // masih input bahan baku
  SELESAI    // sudah selesai dimasak, siap dijadikan output
  DIBATALKAN
}

model Proses {
  id         String       @id @default(cuid())
  nomor      String       @unique
  outletId   String
  userId     String
  tanggal    DateTime     @default(now())
  nama       String?      // label bebas: "Wajan 1", "Adonan Cabai Pagi"
  status     StatusProses @default(DRAFT)
  catatan    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  outlet    Outlet           @relation(fields: [outletId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  bahanBaku ProsesBahanBaku[]
  outputs   OutputProses[]   // junction → bisa dipakai oleh beberapa Output

  @@index([outletId])
  @@index([tanggal])
  @@index([status])
  @@map("proses")
}

model ProsesBahanBaku {
  id                  String  @id @default(cuid())
  prosesId            String
  bahanBakuId         String
  qtyPakai            Decimal @db.Decimal(15, 3)
  qtyWaste            Decimal @default(0) @db.Decimal(15, 3)
  hargaSatuanSaatItu  Decimal @db.Decimal(15, 2)

  proses    Proses    @relation(fields: [prosesId], references: [id], onDelete: Cascade)
  bahanBaku BahanBaku @relation(fields: [bahanBakuId], references: [id])

  @@index([prosesId])
  @@map("proses_bahan_baku")
}

model Output {
  id         String   @id @default(cuid())
  nomor      String   @unique
  outletId   String
  userId     String
  tanggal    DateTime @default(now())
  totalBiaya Decimal  @default(0) @db.Decimal(15, 2) // HPP total dari semua proses terkait
  catatan    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet     Outlet            @relation(fields: [outletId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  proses     OutputProses[]    // junction → bisa gabung dari beberapa Proses
  produkJadi OutputProdukJadi[]
  kemasan    OutputKemasan[]
  biayaLain  OutputBiayaLain[]

  @@index([outletId])
  @@index([tanggal])
  @@map("outputs")
}

// Junction: Output ↔ Proses (many-to-many)
model OutputProses {
  id       String @id @default(cuid())
  outputId String
  prosesId String

  output Output @relation(fields: [outputId], references: [id], onDelete: Cascade)
  proses Proses @relation(fields: [prosesId], references: [id], onDelete: Cascade)

  @@unique([outputId, prosesId])
  @@map("output_proses")
}

model OutputProdukJadi {
  id           String  @id @default(cuid())
  outputId     String
  produkJadiId String
  qty          Decimal @db.Decimal(15, 3)
  hppAlokasi   Decimal @default(0) @db.Decimal(15, 2)

  output     Output     @relation(fields: [outputId], references: [id], onDelete: Cascade)
  produkJadi ProdukJadi @relation(fields: [produkJadiId], references: [id])

  @@index([outputId])
  @@map("output_produk_jadi")
}

model OutputKemasan {
  id                 String  @id @default(cuid())
  outputId           String
  kemasanId          String
  qtyPakai           Decimal @db.Decimal(15, 3)
  hargaSatuanSaatItu Decimal @db.Decimal(15, 2)

  output  Output  @relation(fields: [outputId], references: [id], onDelete: Cascade)
  kemasan Kemasan @relation(fields: [kemasanId], references: [id])

  @@index([outputId])
  @@map("output_kemasan")
}

// Biaya tambahan per batch output (gas, bensin, listrik, dll)
model OutputBiayaLain {
  id        String   @id @default(cuid())
  outputId  String
  kategori  String   // GAS / BENSIN / LISTRIK / TRANSPORTASI / LAINNYA
  jumlah    Decimal  @db.Decimal(15, 2)
  catatan   String?

  output Output @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@index([outputId])
  @@map("output_biaya_lain")
}

// ---------------------------------------------------------------------------
// INVENTORY — RIWAYAT PERGERAKAN STOK
// ---------------------------------------------------------------------------

model StokMovementBahanBaku {
  id          String                @id @default(cuid())
  bahanBakuId String
  tipe        TipePergerakanStok
  qty         Decimal               @db.Decimal(15, 3)
  sumber      SumberPergerakanStok
  referensiId String?
  tanggal     DateTime              @default(now())
  keterangan  String?

  bahanBaku BahanBaku @relation(fields: [bahanBakuId], references: [id])

  @@index([bahanBakuId])
  @@index([tanggal])
  @@map("stok_movement_bahan_baku")
}

model StokMovementKemasan {
  id          String                @id @default(cuid())
  kemasanId   String
  tipe        TipePergerakanStok
  qty         Decimal               @db.Decimal(15, 3)
  sumber      SumberPergerakanStok
  referensiId String?
  tanggal     DateTime              @default(now())
  keterangan  String?

  kemasan Kemasan @relation(fields: [kemasanId], references: [id])

  @@index([kemasanId])
  @@index([tanggal])
  @@map("stok_movement_kemasan")
}

model StokMovementProdukJadi {
  id           String                @id @default(cuid())
  produkJadiId String
  tipe         TipePergerakanStok
  qty          Decimal               @db.Decimal(15, 3)
  sumber       SumberPergerakanStok
  referensiId  String?
  tanggal      DateTime              @default(now())
  keterangan   String?

  produkJadi ProdukJadi @relation(fields: [produkJadiId], references: [id])

  @@index([produkJadiId])
  @@index([tanggal])
  @@map("stok_movement_produk_jadi")
}

// ---------------------------------------------------------------------------
// FINANCE ROOM — MODAL & PENGELUARAN
// ---------------------------------------------------------------------------

model Modal {
  id         String          @id @default(cuid())
  tipe       TipeModal
  sumberDana SumberDanaModal?
  jumlah     Decimal         @db.Decimal(15, 2)
  tanggal    DateTime        @default(now())
  keterangan String?
  userId     String
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([tanggal])
  @@index([tipe])
  @@map("modal")
}

model Pengeluaran {
  id         String   @id @default(cuid())
  outletId   String?
  userId     String
  kategori   String // GAJI / SEWA / LISTRIK_AIR / TRANSPORTASI / MARKETING / LAINNYA (bebas, searchable)
  jumlah     Decimal  @db.Decimal(15, 2)
  tanggal    DateTime @default(now())
  keterangan String?
  createdAt  DateTime @default(now())

  outlet Outlet? @relation(fields: [outletId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@map("pengeluaran")
}
